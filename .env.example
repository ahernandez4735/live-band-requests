# Copy to .env.local for local development. On Vercel, add these under Project Settings > Environment Variables.

# Supabase > Project Settings > API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" key, or the newer "publishable" key. Safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key, or the newer "secret" key. Server only. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Your public URL, used in QR codes. Optional: defaults to the URL the request came in on.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
